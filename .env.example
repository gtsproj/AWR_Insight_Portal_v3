# ============================================================
# DAR Portal v3 — Docker Environment Configuration
# Copy this file to .env and edit all values marked CHANGE ME
# ============================================================

# ── PostgreSQL ─────────────────────────────────────────────
# CHANGE ME: strong password for the postgres superuser
POSTGRES_PASSWORD=ChangeMeNow123
POSTGRES_PORT=5432

# ── Grafana ───────────────────────────────────────────────
# CHANGE ME: Grafana admin password
GRAFANA_PASSWORD=GrafanaAdmin123
GRAFANA_PORT=3000

# ── Portal ────────────────────────────────────────────────
PORTAL_PORT=8000
# CHANGE ME: set to http://<your-server-hostname>:8000
# Used in portal navigation links and email notifications
DAR_PORTAL_URL=http://localhost:8000

# ── Timezone ──────────────────────────────────────────────
# Set to the timezone of your Oracle/Linux servers
# Used for SAR timestamp parsing
# Examples: Asia/Kolkata, Asia/Dubai, Europe/London, US/Eastern
TIMEZONE=Asia/Kolkata

# ── SSH Keys (optional) ───────────────────────────────────
# Path to a folder on the Docker host containing SSH private keys
# for SAR server connections. Leave empty if using passwords.
SSH_KEYS_PATH=./docker/ssh-keys
