      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT\n  snap_time AT TIME ZONE 'Asia/Kolkata' AS \"time\",\n  (CASE WHEN section = 'host' THEN 'host - ' ELSE 'instance - ' END) || metric AS metric,\n  value\nFROM awr_host_instance_cpu\nWHERE '$dbname' != '' AND '$instance' != '' AND '$start_snap' != '' AND '$end_snap' != ''\n  AND dbname = '$dbname'\n  AND instance = '$instance'\n  AND begin_snap BETWEEN split_part('$start_snap',' - ',1)::int AND split_part('$end_snap',' - ',1)::int\n  AND ((section = 'host' AND metric IN ('%User', '%System', '%WIO', '%Idle'))\n    OR (section = 'instance' AND metric IN ('%Total CPU', '%Busy CPU', '%DB time waiting for CPU (Resource Manager)')))\nORDER BY snap_time;",
          "refId": "A"
        }
      ],
      "title": "Host CPU vs Instance CPU (%)",
      "type": "timeseries"
    }
  ],
