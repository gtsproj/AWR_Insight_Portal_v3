          "rawQuery": true,
          "rawSql": "SELECT snap_time AS time,\n  usr_pct AS \"OS user %\", system_pct AS \"OS system %\"\nFROM sar_cpu_stats\nWHERE hostname='${hostname}' AND '${hostname}' != ''\n  AND '${start_snap}' != '' AND '${end_snap}' != ''\n  AND snap_time >= COALESCE(\n    (SELECT snap_time - INTERVAL '30 minutes'\n     FROM awr_load_profile\n     WHERE dbname='${dbname}' AND instance='${instance}'\n     AND begin_snap=split_part('${start_snap}',' - ',1)::int\n     ORDER BY snap_time LIMIT 1),\n    NOW() - INTERVAL '999 years')\nAND snap_time <= COALESCE(\n    (SELECT snap_time + INTERVAL '30 minutes'\n     FROM awr_load_profile\n     WHERE dbname='${dbname}' AND instance='${instance}'\n     AND begin_snap=split_part('${end_snap}',' - ',1)::int\n     ORDER BY snap_time LIMIT 1),\n    NOW() + INTERVAL '999 years')\n  AND cpu='all'\nORDER BY snap_time",
