      "targets": [
        {
          "format": "time_series",
          "rawSql": "WITH top_enq AS (  SELECT e.enqueue_type_request_reason  \nFROM awr_enqueue_statistics e  \nWHERE '$dbname' != '' AND '$instance' != '' \nAND '$start_snap' != '' AND '$end_snap' != ''    \nAND e.dbname = '$dbname'    AND e.instance = '$instance' \nAND e.begin_snap BETWEEN split_part('$start_snap',' - ',1)::int AND split_part('$end_snap',' - ',1)::int  \nGROUP BY e.enqueue_type_request_reason  \nORDER BY SUM(e.waits) DESC   LIMIT 10) \nSELECT  e.snap_time AT TIME ZONE 'Asia/Kolkata' AS time,  e.enqueue_type_request_reason,  e.waits \nFROM awr_enqueue_statistics e \nJOIN top_enq t ON t.enqueue_type_request_reason = e.enqueue_type_request_reason \nWHERE '$dbname' != '' AND '$instance' != '' \nAND '$start_snap' != '' AND '$end_snap' != ''  \nAND e.dbname = '$dbname'  AND e.instance = '$instance'  \nAND e.begin_snap BETWEEN split_part('$start_snap',' - ',1)::int AND split_part('$end_snap',' - ',1)::int \nORDER BY time;",
          "refId": "A"
        }
      ],
      "title": "Top 10 Enqueue Types by Waits",
      "type": "timeseries"
    },
