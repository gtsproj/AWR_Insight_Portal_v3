      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT enqueue_type_request_reason AS metric, AVG(av_wt_time_ms) AS avg_wait_time_ms\nFROM awr_enqueue_statistics\nWHERE '$dbname' != '' AND '$instance' != '' AND '$start_snap' != '' AND '$end_snap' != ''\n  AND dbname = '$dbname'\n  AND instance = '$instance'\n  AND begin_snap BETWEEN split_part('$start_snap',' - ',1)::int AND split_part('$end_snap',' - ',1)::int\nGROUP BY enqueue_type_request_reason\nORDER BY avg_wait_time_ms DESC\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Avg Wait Time (ms) by Enqueue Type (Top 10)",
