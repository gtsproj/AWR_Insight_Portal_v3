          "format": "table",
          "rawSql": "SELECT enqueue_type_request_reason, SUM(requests) AS requests, SUM(succ_gets) AS succ_gets,\n       SUM(failed_gets) AS failed_gets, SUM(waits) AS waits, SUM(wt_time_s) AS total_wait_time_s\nFROM awr_enqueue_statistics\nWHERE '$dbname' != '' AND '$instance' != '' AND '$start_snap' != '' AND '$end_snap' != ''\n  AND dbname = '$dbname'\n  AND instance = '$instance'\n  AND begin_snap BETWEEN split_part('$start_snap',' - ',1)::int AND split_part('$end_snap',' - ',1)::int\nGROUP BY enqueue_type_request_reason\nORDER BY requests DESC\nLIMIT 10;",
