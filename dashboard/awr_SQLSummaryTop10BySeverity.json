          "format": "table",
          "rawSql": "SELECT sql_id,severity_score,\n       executions,\n       elapsed_time_per_exec_s,\n       cpu_per_exec_s,\n       user_io_wait_per_exec_s,\n       buffer_gets_per_exec,\n       disk_reads_per_exec,\n       unoptimized_reqs_per_exec,\n       parse_calls,\n       cluster_wait_time_per_exec_s\nFROM awr_sql_summary_mv\nWHERE dbname = '$dbname'\n  AND instance = '$instance'\n  AND begin_snap BETWEEN split_part('$start_snap',' - ',1)::int AND split_part('$end_snap',' - ',1)::int\nORDER BY severity_score DESC\nLIMIT 10;",
