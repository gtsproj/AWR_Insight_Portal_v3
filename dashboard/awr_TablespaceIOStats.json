          "rawSql": "WITH top_ts AS (\n  SELECT tablespace\n  FROM awr_tablespace_io_stats\n  WHERE '$dbname' != '' AND '$instance' != '' AND '$start_snap' != '' AND '$end_snap' != ''\n    AND dbname = '$dbname'\n    AND instance = '$instance'\n    AND begin_snap BETWEEN split_part('$start_snap',' - ',1)::int AND split_part('$end_snap',' - ',1)::int\n  GROUP BY tablespace\n  ORDER BY SUM(writes) DESC\n  LIMIT 10\n)\nSELECT\n  t.snap_time AT TIME ZONE 'Asia/Kolkata' AS \"time\",\n  t.tablespace,\n  t.writes::numeric AS writes_ops\nFROM awr_tablespace_io_stats t\nJOIN top_ts x ON x.tablespace = t.tablespace\nWHERE '$dbname' != '' AND '$instance' != '' AND '$start_snap' != '' AND '$end_snap' != ''\n  AND t.dbname = '$dbname'\n  AND t.instance = '$instance'\n  AND t.begin_snap BETWEEN split_part('$start_snap',' - ',1)::int AND split_part('$end_snap',' - ',1)::int\nORDER BY \"time\";",
