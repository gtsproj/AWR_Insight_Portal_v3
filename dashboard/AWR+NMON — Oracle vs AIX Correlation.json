      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "ferwfz6k211j4b"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT snap_time AS time,\n  event AS metric, pct_db_time AS \"Oracle Wait % DB Time\"\nFROM awr_foreground_wait_events\nWHERE dbname='${dbname}' AND '${dbname}' != '' AND '${instance}' != ''\n  AND '${start_snap}' != '' AND '${end_snap}' != ''\n  AND begin_snap BETWEEN split_part('${start_snap}',' - ',1)::int\n                     AND split_part('${end_snap}',' - ',1)::int\n  AND event IN ('db file sequential read','db file scattered read','direct path read')\nORDER BY snap_time\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "ferwfz6k211j4b"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT snap_time AS time, wait_pct AS \"NMON OS iowait %\"\nFROM nmon_cpu_stats\nWHERE '${hostname}' != '' AND hostname='${hostname}'\n  AND '${start_snap}' != '' AND '${end_snap}' != ''\n  AND snap_time >= COALESCE(\n    (SELECT snap_time - INTERVAL '30 minutes' FROM awr_load_profile\n     WHERE dbname='${dbname}' AND instance='${instance}'\n       AND begin_snap = split_part('${start_snap}',' - ',1)::int LIMIT 1),\n    NOW() - INTERVAL '24 hours')\n  AND snap_time <= COALESCE(\n    (SELECT snap_time + INTERVAL '30 minutes' FROM awr_load_profile\n     WHERE dbname='${dbname}' AND instance='${instance}'\n       AND begin_snap = split_part('${end_snap}',' - ',1)::int LIMIT 1),\n    NOW()) AND cpu='ALL'\nORDER BY snap_time",
          "refId": "B",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Oracle I/O Wait Events % DB Time  vs  NMON OS iowait %",
      "type": "timeseries"
    },
