          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT snap_time AS time, runq_sz AS \"Run Queue Length\"\nFROM nmon_runqueue_stats\nWHERE '${hostname}' != '' AND hostname='${hostname}'\n  AND '${start_snap}' != '' AND '${end_snap}' != ''\n  AND snap_time >= COALESCE(\n    (SELECT snap_time - INTERVAL '30 minutes' FROM awr_load_profile\n     WHERE dbname='${dbname}' AND instance='${instance}'\n       AND begin_snap = split_part('${start_snap}',' - ',1)::int LIMIT 1),\n    NOW() - INTERVAL '24 hours')\n  AND snap_time <= COALESCE(\n    (SELECT snap_time + INTERVAL '30 minutes' FROM awr_load_profile\n     WHERE dbname='${dbname}' AND instance='${instance}'\n       AND begin_snap = split_part('${end_snap}',' - ',1)::int LIMIT 1),\n    NOW())\nORDER BY snap_time",
