        {
          "datasource": {
            "type": "postgres",
            "uid": "ferwfz6k211j4b"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  snap_time AS time,-- AT TIME ZONE 'Asia/Kolkata' AS \"time\",\n  ROUND(\n    CASE\n      WHEN MAX(CASE WHEN metric = 'DB Time(s)' THEN per_sec END) > 0\n      THEN (\n        MAX(CASE WHEN metric = 'DB CPU(s)'  THEN per_sec END) /\n        MAX(CASE WHEN metric = 'DB Time(s)' THEN per_sec END)\n      ) * 100\n      ELSE 0\n    END::numeric, 2\n  ) AS \"Oracle CPU % of DB Time\",\n  ROUND(\n    MAX(CASE WHEN metric = 'DB CPU(s)' THEN per_sec END)::numeric, 2\n  ) AS \"Oracle DB CPU (s/sec)\"\nFROM awr_load_profile\nWHERE '${dbname}'   != '' AND dbname   = '${dbname}'\n  AND '${instance}' != '' AND instance = '${instance}'\n  AND '${start_snap}' != '' AND '${end_snap}' != ''\n  AND begin_snap BETWEEN split_part('${start_snap}',' - ',1)::int\n                     AND split_part('${end_snap}',' - ',1)::int\n  AND metric IN ('DB Time(s)', 'DB CPU(s)')\nGROUP BY snap_time\nORDER BY snap_time",
          "refId": "A",
          "sql": {
            "columns": [
